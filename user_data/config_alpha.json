{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "max_open_trades": 1,
    "position_adjustment_enable": true,
    "max_entry_position_adjustment": 3,
    "stake_currency": "USDT",
    "stake_amount": "unlimited",
    "dry_run_wallet": 1100,
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "USD",
    "timeframe": "1h",
    "dry_run": false,
    "cancel_open_orders_on_exit": false,
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": false,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": false,
        "order_book_top": 1
    },
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "ccxt_config": {},
        "ccxt_async_config": {},
        "skip_pair_validation": true,
        "pair_whitelist": [
            "TGT/USDT", "XPIN/USDT"
        ],
        "pair_blacklist": [],
        "unknown_fee_rate": 0.001
    },
    "fee": 0.001,
    "pairlists": [
        {
            "method": "StaticPairList",
            "allow_inactive": true
        }
    ],
    "telegram": {
        "enabled": false,
        "token": "dummy_token",
        "chat_id": "dummy_chat_id"
    },
    "api_server": {
        "enabled": true,
        "listen_ip_address": "127.0.0.1",
        "listen_port": 8080,
        "verbosity": "error",
        "jwt_secret_key": "somethingrandom",
        "CORS_origins": [],
        "username": "freqtrader",
        "password": "SuperSecurePassword"
    },
    "bot_name": "freqtrade_alpha",
    "initial_state": "running",
    "force_entry_enable": true,
    "internals": {
        "process_throttle_secs": 5
    },
    "datadir": "user_data/data"
}